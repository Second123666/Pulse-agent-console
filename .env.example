# 前端环境变量 —— 复制为 .env 后按需修改（.env 不入库）
# 这些值在 dev server 启动时注入，改完要重启 pnpm dev

# axios 的 API 前缀。**必须与 vite 代理的匹配规则一致**：
# 少了它请求会打到 /session 而不是 /api/session，代理只匹配 /api → 404 → 前端跳 /500
VITE_GLOB_API_URL=/api

# vite dev server 的代理目标（仅开发环境使用；生产环境由 nginx 反代 /api，见 Dockerfile）
VITE_APP_API_BASE_URL=http://127.0.0.1:3002/

# 长回复自动续写（配合后端 finish_reason === 'length'）
VITE_GLOB_OPEN_LONG_REPLY=false

# PWA
VITE_GLOB_APP_PWA=false
