# 模型服务商的 API Key（示例：智谱 AI https://open.bigmodel.cn）
API_KEY=

# OpenAI 兼容接口的基础地址
# 智谱:    https://open.bigmodel.cn/api/paas/v4
# DeepSeek: https://api.deepseek.com
# 通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1
API_BASE_URL=

# 模型名称（示例：glm-4-flash / deepseek-chat / qwen-plus）
API_MODEL=

# 置为 true 可关闭后端请求日志
DISABLE_DEBUG=

# timeout
TIMEOUT_MS=100000

# Rate Limit
MAX_REQUEST_PER_HOUR=

# ===== 鉴权（用户体系）=====
# 注册邀请码（沿用旧变量名，语义已变更：不再是登录口令）
# - 不配置：开放注册，首个注册用户自动成为管理员
# - 配置后：注册必须携带该邀请码（防止他人抢先注册）
AUTH_SECRET_KEY=
# JWT 签名密钥（强烈建议配置；未配置则每次启动生成临时随机密钥，重启后登录态全部失效）
# 生成：node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# 登录态有效期（秒），默认 604800（7 天）
AUTH_TOKEN_TTL=604800
# 用户数据库路径（可选，默认 service/data/agent.db；测试可设为 :memory:）
AGENT_DB_PATH=

# ===== Agent 模式（/agent-process 端点）=====
# OpenAI 兼容接口地址与模型（Agent 循环专用，可用与上方相同的服务商）
OPENAI_API_BASE_URL=
OPENAI_API_MODEL=
# 最大工具调用步数（熔断，防止死循环）
AGENT_MAX_STEPS=10
# 每轮对话 token 预算（熔断，超出后要求模型总结收尾）
AGENT_TOKEN_BUDGET=30000
# 向量化模型（RAG 知识库使用）；若服务商与聊天不同，可另配 EMBEDDING_API_BASE_URL / EMBEDDING_API_KEY
EMBEDDING_MODEL=
# 独立 embedding 接口地址与 key（可选，缺省回退 OPENAI_API_BASE_URL / API_KEY）
# 例：智谱 https://open.bigmodel.cn/api/paas/v4 + embedding-3
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=

# ===== 工具 =====
# web_search 工具的搜索服务 key：博查 Web Search API（https://open.bochaai.com，国内直连）
# 注册送 1000 次调用；不配置时工具返回"未配置"提示（不抛错）
SEARCH_API_KEY=

# ===== MCP 兼容层（可选）=====
# 配置 MCP server 列表（JSON），启动时拉取其工具并桥接进 registry，如：
# MCP_SERVERS=[{"name":"demo","url":"http://localhost:3000/mcp"}]
MCP_SERVERS=
