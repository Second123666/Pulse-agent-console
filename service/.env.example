# 模型服务商的 API Key（示例：智谱 AI https://open.bigmodel.cn）
API_KEY=

# OpenAI 兼容接口的基础地址
# 智谱:    https://open.bigmodel.cn/api/paas/v4
# DeepSeek: https://api.deepseek.com
# 通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1
API_BASE_URL=

# 模型名称（示例：glm-4-flash / deepseek-chat / qwen-plus）
API_MODEL=

# 置为 true 可关闭后端请求日志
DISABLE_DEBUG=

# timeout
TIMEOUT_MS=100000

# Rate Limit
MAX_REQUEST_PER_HOUR=

# Secret key
AUTH_SECRET_KEY=
