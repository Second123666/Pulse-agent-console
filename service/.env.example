# 模型服务商的 API Key（示例：智谱 AI https://open.bigmodel.cn）
API_KEY=

# OpenAI 兼容接口的基础地址
# 智谱:    https://open.bigmodel.cn/api/paas/v4
# DeepSeek: https://api.deepseek.com
# 通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1
API_BASE_URL=

# 模型名称（示例：glm-4-flash / deepseek-chat / qwen-plus）
API_MODEL=

# 置为 true 可关闭后端请求日志
DISABLE_DEBUG=

# timeout
TIMEOUT_MS=100000

# Rate Limit
MAX_REQUEST_PER_HOUR=

# Secret key
AUTH_SECRET_KEY=

# ===== Agent 模式（/agent-process 端点）=====
# OpenAI 兼容接口地址与模型（Agent 循环专用，可用与上方相同的服务商）
OPENAI_API_BASE_URL=
OPENAI_API_MODEL=
# 最大工具调用步数（熔断，防止死循环）
AGENT_MAX_STEPS=10
# 每轮对话 token 预算（熔断，超出后要求模型总结收尾）
AGENT_TOKEN_BUDGET=30000
# 向量化模型（RAG 知识库使用）
EMBEDDING_MODEL=

# ===== 工具 =====
# web_search 工具的搜索服务 key（如 Tavily https://tavily.com）；不配置时工具返回"未配置"提示
SEARCH_API_KEY=
